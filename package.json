{
  "name": "note-replace",
  "version": "0.1.0",
  "description": "Desktop presentation and PDF annotation editor built with Electron and React",
  "author": "WorkRCS",
  "main": "dist-electron/electron/main/main.js",
  "type": "module",
  "engines": {
    "node": ">=22 <25",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1",
    "clean:release": "node scripts/clean-release.mjs",
    "dist": "npm run clean:release && electron-builder --config electron-builder.yml --publish never",
    "dist:build": "npm run build && npm run dist"
  },
  "dependencies": {
    "fast-xml-parser": "latest",
    "jszip": "latest",
    "lucide-react": "latest",
    "pdfjs-dist": "latest",
    "pptxgenjs": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  }
}
