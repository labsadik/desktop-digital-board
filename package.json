{
  "name": "note-replace",
  "version": "0.1.0",
  "description": "Desktop digital-board and PDF annotation editor built with Electron and React",
  "author": "WorkRCS",
  "main": "dist-electron/electron/main/main.js",
  "type": "module",
  "engines": { "node": ">=22 <25", "npm": ">=10" },
  "scripts": {
    "predev": "npm run build",
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && node scripts/start-dev-electron.mjs\"",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json",
    "start": "npm run build && electron .",
    "start:built": "electron .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1",
    "clean:release": "node scripts/clean-release.mjs",
    "dist": "npm run build && electron-builder --config electron-builder.yml --publish never",
    "dist:win": "npm run dist -- --win nsis"
  },
  "dependencies": {
    "lucide-react": "latest",
    "pdf-lib": "latest",
    "pdfjs-dist": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "jsdom": "latest",
    "typescript": "latest",
    "vitest": "latest",
    "wait-on": "latest"
  }
}
